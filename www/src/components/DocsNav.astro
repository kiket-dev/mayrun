---
import { DOC_NAV } from "../consts";

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<nav class="docs-nav" aria-label="Docs">
  {
    DOC_NAV.map((group) => (
      <div class="docs-nav-group">
        <p class="docs-nav-label">{group.label}</p>
        <ul>
          {group.items.map((item) => (
            <li>
              <a
                href={`/docs/${item.slug}`}
                aria-current={current === item.slug ? "page" : undefined}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
